# Copy to .env (same folder, gitignored) and fill in what you need. night.mjs reads it;
# anything already set in the environment wins. Never commit the real file.

# Data folder: VODs, Shorts, reports, config.json. Default D:\Videos\SecretShop.
HC_DATA=

# Only needed when they aren't on the PATH.
FFMPEG=
FFPROBE=
YTDLP=

# Whisper model for captions. Default: the best ggml-*.bin in <data>\models.
HC_WHISPER_MODEL=

# Reads approved clips from the site's queue. Ask an admin; it's in Cloudflare as CLIPS_BOT_TOKEN.
CLIPS_BOT_TOKEN=

# night.mjs --sample: the full 30 Sep VOD (a file path or its link). Only sample.json's section is kept.
HC_SAMPLE_SOURCE=
# Optional: another sample file, or another folder for the sample's output (default .sample-data here).
HC_SAMPLE=
HC_SAMPLE_DATA=

# Free space a night run needs before it downloads a VOD, in bytes. Default 12e9.
HC_MIN_FREE=
