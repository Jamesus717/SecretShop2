<?xml version="1.0" encoding="UTF-16"?>
<!-- Windows Task Scheduler template for the night run. NOT registered by anything in this repo.
     1. Replace C:\PATH\TO\SecretShop2 below with where the repo lives (and the data folder if it isn't D:\Videos\SecretShop).
     2. Register it:  schtasks /Create /TN "SecretLeague night run" /XML night-task.xml
        (or Task Scheduler → Import Task…). Remove it:  schtasks /Delete /TN "SecretLeague night run" /F
     3. Test first:  node night.mjs (with the dry-run, no-schedule and no-inbox flags, see the README)
     Save this file as UTF-16 if schtasks complains about the encoding. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>Makes Shorts from last night's playoff games and writes a report. Posts nothing.</Description></RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-03T02:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals><Principal id="Author"><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <WakeToRun>true</WakeToRun>
    <ExecutionTimeLimit>PT6H</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\PATH\TO\SecretShop2\tools\highlight-cutter\night.bat</Command>
      <Arguments>"D:\Videos\SecretShop"</Arguments>
      <WorkingDirectory>C:\PATH\TO\SecretShop2\tools\highlight-cutter</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
